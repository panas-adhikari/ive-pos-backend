# Local development only. Replace before using outside your own machine.
APP_ENV=development
POSTGRES_DB=retail_pos
POSTGRES_USER=retail_dev
POSTGRES_PASSWORD=local_development_only
# Docker assigns an available localhost API port when started.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET=
# Use the deployed HTTPS app URL for links sent to external recipients.
PUBLIC_ORIGIN=http://localhost:5173

# Enables email onboarding/recovery and encrypts MFA secrets and queued mail.
# Generate once: backend/venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
IDENTITY_ENCRYPTION_KEY=
# Set BREVO_API_KEY to use Brevo transactional email, or EMAIL_PROVIDER=smtp to use SMTP.
EMAIL_PROVIDER=
BREVO_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Onboard
EMAIL_OPERATIONS_FROM=operator@example.com
EMAIL_OPERATIONS_FROM_NAME=Operations
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Native backend only: override DATABASE_URL with a local PostgreSQL URL.
# Compose derives DATABASE_URL from POSTGRES_* above.
# Production uses deploy/.env.production.example and a separate external volume.
