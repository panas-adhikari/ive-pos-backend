{$API_DOMAIN} {
    reverse_proxy api-proxy:8000
}

# Optional low-cost frontend on this same VM for real users.
# For Pages demonstrations, point app.<domain> DNS at Pages instead.
{$APP_DOMAIN} {
    root * /srv
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
    }
    try_files {path} /index.html
    file_server
}
