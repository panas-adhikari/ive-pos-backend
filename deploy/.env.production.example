# Copy OUTSIDE the checkout, e.g. /etc/ive/production.env; chmod 600.
BACKUP_ENV_FILE=/etc/ive/backup.env
APP_ENV=production
DB_PROVIDER=postgres
COMPOSE_PROFILES=${DB_PROVIDER:-postgres}
# Direct or session pooler URI, port 5432, with ?sslmode=require.
SUPABASE_DATABASE_URL=
POSTGRES_DB=ive_production
POSTGRES_USER=ive_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
APP_DATABASE_USER=ive_app
APP_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
DATABASE_URL=postgresql://ive_app:REPLACE_WITH_RANDOM_APP_PASSWORD@db:5432/ive_production
AUTH_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
IDENTITY_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
PUBLIC_ORIGIN=https://ivepos.me
TENANT_BASE_DOMAIN=ivepos.me
API_DOMAIN=api.ivepos.me
APP_DOMAIN=ivepos.me
FORWARDED_ALLOW_IPS=172.30.90.2
# If the default proxy subnet conflicts, change all three together:
# PROXY_SUBNET=172.30.90.0/24
# PROXY_IP=172.30.90.2
# API_PROXY_IP=172.30.90.3
RUN_DELETION_WORKER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Ive POS
# Brevo alternative: EMAIL_PROVIDER=brevo and BREVO_API_KEY=...
BREVO_API_KEY=
FRONTEND_DIST_DIR=/opt/ive/frontend-dist
# Before a real release, set tested immutable image tags/digests:
APP_IMAGE=ive-pos-api:production
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
