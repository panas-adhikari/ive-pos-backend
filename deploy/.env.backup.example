# Separate credentials from the API. This must be an OFF-SERVER repository.
# Example S3-compatible storage; restic also supports SFTP and other backends.
RESTIC_REPOSITORY=s3:https://s3.example.com/ive-backups
RESTIC_PASSWORD=REPLACE_WITH_RANDOM_BACKUP_ENCRYPTION_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ONLY_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_ONLY_SECRET
# Store this password in an independent password manager: losing it loses backups.
